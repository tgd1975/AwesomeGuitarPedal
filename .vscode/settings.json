{
    "C_Cpp.default.configurationProvider": "ms-vscode.cpptools",
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/.vscode/build",
    "cmake.generator": "Unix Makefiles",
    "cmake.cmakePath": "cmake",
    "C_Cpp.intelliSenseEngine": "Default",
    "C_Cpp.errorSquiggles": "Enabled",
    "C_Cpp.autocomplete": "Default",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.DS_Store": true,
        "**/.pio": true,
        "**/build": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/.pio": true,
        "**/build": true
    },
    "testMate.cpp.test.executables": "${workspaceFolder}/.vscode/build/test/pedal_tests",
    "testMate.cpp.test.workspaceDiscover.ignoredPaths": [
        "${workspaceFolder}/.pio/**",
        "${workspaceFolder}/test/test_*/**"
    ],
    "platformio-ide.disablePIOHomeStartup": true,
    "chat.useAgentSkills": true,
    "claudeCode.environmentVariables": [

    ],
    "yaml.schemaStore.enable": false,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            ".github/workflows/test.yml"
        ]
    },
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#2E1F1F",
        "titleBar.activeForeground": "#E8E8E8",
        "titleBar.inactiveBackground": "#251717",
        "titleBar.inactiveForeground": "#9C9C9C",
        "titleBar.border": "#1B1010",

        "activityBar.background": "#2E1F1F",
        "activityBar.foreground": "#E8E8E8",
        "activityBar.inactiveForeground": "#9C9C9C",
        "activityBar.border": "#1B1010",

        "statusBar.background": "#251717",
        "statusBar.foreground": "#E8E8E8",
        "statusBar.border": "#1B1010",
        "statusBar.debuggingBackground": "#382626",
        "statusBar.noFolderBackground": "#1B1010"
    }
}
